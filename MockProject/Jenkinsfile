pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID    = '475309741409'
        AWS_REGION        = 'ap-southeast-1'
        ECR_HOST          = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO          = "${ECR_HOST}/long-app"
        IMAGE_TAG         = "${env.BUILD_NUMBER}"
        AWS_CREDENTIAL_ID = 'aws-credentials'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('MockProject') {
                    sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('MockProject') {
                    sh 'docker run --rm -v $PWD:/app -w /app node:18-alpine sh -c "npm install && npm test"'
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.AWS_CREDENTIAL_ID, usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${ECR_HOST}
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    dir('MockProject') {
                        sh """
                            export KUBECONFIG=${KUBECONFIG}
                            kubectl apply -f deployment.yaml
                            kubectl set image deployment/long-app long-app=${ECR_REPO}:${IMAGE_TAG}
                            kubectl rollout status deployment/long-app
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Build/Deploy thành công.'
        }
        failure {
            echo 'Build/Deploy thất bại – kiểm tra log để rollback nếu cần.'
        }
    }
}
